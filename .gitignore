# Dotenv files (local secrets — never commit)
.env*
!.env.example

# IDE
.vscode/
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Temporary folders and files
tmp/
temp/
cache/
*cache/
.references/
.playwright*/
*.*~*

# Build outputs
dist/
build/
*.min.js
*.min.css

# Rust / Cargo (crates/*, apps/desktop/tauri)
target/
debug/
**/*.rs.bk
*.pdb
*.stackdump
# Note: IS committed (workspace ships binaries — reproducible builds).
#Cargo.lock

# Node / pnpm (packages/*, apps/*)
node_modules/
.pnpm-store/
.npm/
*.tsbuildinfo
# Note: IS committed (reproducible installs).
#pnpm-lock.yaml

# Vite
.vite/
*.timestamp-*.mjs

# Tauri (apps/desktop/tauri)
**/tauri/gen/
# tauri/target is covered by `target/` above.
# Signing keys — never commit.
*.keystore
*.jks
*.p12

# fallow (codebase intelligence) — ignore local cache only; fallow-baselines/ ARE committed.
.fallow/

# Editor backup files
*.bak
*.tmp

.gemini/
gha-creds-*.json

# Local settings
*/settings.json
*/settings.*.json

# Agents
CLAUDE.md
GEMINI.md
CODEX.md
QWEN.md
copilot-instructions.md

# Skills
/.*/skills/
!/.*/skills/release

# SDD engine
/.magic/
/.*/skills/magic-*/
/.*/*/magic*.md

# SDD generated artifacts, rebuilt on demand by the engine (the rest of .design/ is shared)
/.design/*graph*.*
/.design/*cache*/
/.design/wiki/
